{
  "expo": {
    "name": "Worthout",
    "slug": "worthout",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.worthout.app"
    },
    "android": {
      "package": "com.worthout.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@clerk/expo",
      "expo-secure-store"
    ],
    "scheme": "worthout",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "43fbd339-03d0-4732-a1b0-96aa8282d61f"
      }
    },
    "owner": "kerads-team"
  }
}
